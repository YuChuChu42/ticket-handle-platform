# 阿里云文档转换服务配置（可选）
# 如果配置了这些密钥，将使用阿里云服务生成PDF，完美支持中文
# 如果未配置，将降级到本地PDFKit方案
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# 获取方式：
# 1. 登录阿里云控制台
# 2. 访问：https://ram.console.aliyun.com/manage/ak
# 3. 创建AccessKey
# 4. 开通文档转换服务：https://docconvert.console.aliyun.com/
# 5. 将密钥填入上面的配置项
